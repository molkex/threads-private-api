# Threads SDK Environment Configuration

# Optional: Remote cryptographic signing daemon API key
THREADS_API_KEY=

# Optional: Pre-authenticated Threads / Instagram Bearer session token
THREADS_SESSION_TOKEN=

# Path to persisted session state JSON file
THREADS_SESSION_FILE=session_threads.json

# Device preset: 'threads_ios' (iPhone 15 Pro) or 'threads_android' (Samsung Galaxy A34)
THREADS_DEVICE_PRESET=threads_ios

# Optional proxy URI (e.g. http://user:pass@host:port or socks5://host:port)
THREADS_PROXY=
